[Unit]
Description=Lead Flow Planner website and API
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/bot-lead-flow
Environment=PATH=/opt/bot-lead-flow/.venv/bin
ExecStart=/opt/bot-lead-flow/.venv/bin/uvicorn apps.planner.backend.main:app --host 127.0.0.1 --port 8082
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
