# Входящий вебхук Bitrix24 (Приложения -> Разработчикам -> Другое -> Входящий вебхук)
# права: crm, user
BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx/

# Токен из исходящего вебхука Bitrix24 (auth[application_token] в теле запроса)
BITRIX_APPLICATION_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Токен бота из @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID чата/группы, куда слать уведомления (можно узнать через getUpdates
# или бота @userinfobot / @getmyid_bot; для группы обычно отрицательное число)
TELEGRAM_CHAT_ID=-1001234567890

# Секрет для проверки заголовка X-Telegram-Bot-Api-Secret-Token на /telegram/webhook
# (придумайте случайную строку, укажите её же в setWebhook при регистрации вебхука)
TELEGRAM_WEBHOOK_SECRET=придумайте-случайную-строку

# Telegram user_id людей, кому доступны кнопки управления лидом, через запятую
# (узнать свой ID можно у бота @userinfobot)
ADMIN_TELEGRAM_USER_IDS=123456789,987654321

# ID отдела в Bitrix, из которого предлагать ответственных при назначении (department.get)
SALES_DEPARTMENT_ID=5

# STATUS_ID лидовой стадии "Мусор" (crm.status.list, filter ENTITY_ID=STATUS)
JUNK_STATUS_ID=UC_NLD47X
