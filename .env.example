# Входящий вебхук Bitrix24 (Приложения -> Разработчикам -> Другое -> Входящий вебхук)
# права: crm, user
BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx/

# Токен из исходящего вебхука Bitrix24 (auth[application_token] в теле запроса)
# Если для событий созданы разные исходящие вебхуки, перечислите их токены через запятую.
BITRIX_APPLICATION_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Токен бота из @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID чата/группы, куда слать уведомления (можно узнать через getUpdates
# или бота @userinfobot / @getmyid_bot; для группы обычно отрицательное число)
TELEGRAM_CHAT_ID=-1001234567890

# Дополнительные получатели уведомлений основного бота, через запятую.
# Права администратора сами по себе не подписывают человека на уведомления.
TELEGRAM_NOTIFICATION_CHAT_IDS=

# Секрет для проверки заголовка X-Telegram-Bot-Api-Secret-Token на /telegram/webhook
# (придумайте случайную строку, укажите её же в setWebhook при регистрации вебхука)
TELEGRAM_WEBHOOK_SECRET=придумайте-случайную-строку

# Telegram user_id руководителей — кнопки управления лидом (назначить/в мусор), через запятую
# (узнать свой ID можно у бота @userinfobot)
DIRECTOR_USERS=123456789,987654321

# Сохраняют остальные права, но не получают новые лиды/сделки и назначения.
LEAD_NOTIFICATION_EXCLUDED_USERS=

# Telegram user_id админов бота — доступ только к /link и /links (привязка продажник↔Telegram),
# к управлению лидами доступа нет. Можно оставить пустым, если пока некому.
ADMIN_USERS=

# ID отдела в Bitrix, из которого предлагать ответственных при назначении (department.get)
# Тот же список используется в команде /link для привязки продажника к Telegram.
SALES_DEPARTMENT_ID=5
EXCLUDED_SALES_USER_IDS=26
EXCLUDED_SALES_USER_NAMES=Анастасия Коравчук

DATABASE_PATH=data/leads.sqlite3

# Production PostgreSQL (используется docker-compose.yml).
# Сгенерируйте длинный пароль из букв и цифр, чтобы он безопасно входил в DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Локальный адрес и порт backend-контейнера на сервере.
APP_BIND=127.0.0.1
APP_PORT=8080

# Воронка сделок, новые сделки из которой отправляются в основной бот.
# 0 — основная воронка «Продажа».
TRACK_DEAL_CATEGORY_ID=0
DEAL_POLL_INTERVAL_SECONDS=15

# Стадии, на которых обращение ещё считается необработанным.
LEAD_UNPROCESSED_STATUS_ID=NEW
DEAL_UNPROCESSED_STAGE_ID=NEW

# Ежедневный отчёт руководителям.
DAILY_STATS_TIME=19:00
DAILY_STATS_TIMEZONE=Europe/Moscow

# Страхующая сверка с Bitrix на случай пропущенного исходящего вебхука.
RECONCILE_INTERVAL_SECONDS=300
RECONCILE_OVERLAP_SECONDS=300
RECONCILE_INITIAL_LOOKBACK_HOURS=24

# Незавершённые ручные заявки повторяются с экспоненциальной задержкой.
MANUAL_RECOVERY_MAX_ATTEMPTS=5
MANUAL_RECOVERY_BASE_DELAY_SECONDS=30

# Ежедневная сверка текущего результата обращений с CRM.
OUTCOME_SYNC_TIME=03:00

# Воронка «Сопровождение»: появление связанной сделки здесь означает заключённый договор.
ACCOMPANIMENT_DEAL_CATEGORY_ID=2

# Поле «Ссылка на договор» в сделке сопровождения; содержит ID исходной сделки продажи.
CONTRACT_SOURCE_URL_FIELD=UF_CRM_1775217002

# Поля мотивационного отчёта: причина отказа и дата входа в сопровождение.
DEAL_REFUSAL_REASON_FIELD=UF_CRM_REFUSAL_REASON_OP
DEAL_CONTRACT_DATE_FIELD=UF_CRM_CONTRACT_DATE_OP

# HTTPS-адрес Telegram Mini App со статистикой.
MINI_APP_URL=https://lead.prav-buro.ru/miniapp

# Planner внутри Lead Flow и единственный пользователь переключателя /mode.
MANAGER_APP_URL=https://tg.prav-buro.ru/workday/
MANAGER_PLANNER_DATABASE_PATH=data/manager_planner.sqlite3
LEGACY_DISTRIBUTION_QUEUE_HOST_DIR=./data/legacy-distribution-queue
LEGACY_DISTRIBUTION_QUEUE_PATH=
LEGACY_DISTRIBUTION_CONFIRMER_IDS=
LEGACY_DISTRIBUTION_POLL_SECONDS=30
DISTRIBUTION_CONFIRMER_IDS=1297686797
MODE_SWITCH_USER_ID=1297686797

# Закрытый канал чтения статусов менеджеров из LeadFlow для Telegram Mini App.
LEADFLOW_PRESENCE_URL=https://lead.prav-buro.ru/api/v1/users/internal-presence
LEADFLOW_PRESENCE_TOKEN=replace-with-a-long-random-token

# Дополнительный доступ к Mini App помимо руководителей и администраторов.
SUPER_ADMIN_USERS=1297686797

# Тот же CRM auth token, который МегаФон присылает центральному call_queue.
MEGAFON_CRM_TOKEN=
# JSON: внутренний номер МегаФона -> Bitrix user ID.
MEGAFON_BITRIX_USER_MAP={}
BITRIX_AUTOMATION_USER_IDS=24
# Manager dialer (MegaFon VATS CRM API)
MEGAFON_VATS_API_URL=
MEGAFON_VATS_API_KEY=
MEGAFON_VATS_AUTH_MODE=header
MEGAFON_VATS_AUTH_HEADER=X-API-KEY
MEGAFON_DIALER_USERS={}

# Standalone Planner web login reuses the existing Lead Flow accounts.
LEADFLOW_WEB_AUTH_URL=https://tg.prav-buro.ru/api/v1/auth/me
LEADFLOW_WEB_AUTH_TIMEOUT_SECONDS=5
TELEGRAM_BOT_USERNAME=lead_notification_prav_buro_bot
TELEGRAM_LOGIN_MAX_AGE_SECONDS=600
TELEGRAM_WEB_SESSION_SECONDS=43200
